{
	"layer": "top",
	"modules-left": ["tray"],
	"modules-center": ["clock"],
	"modules-right": ["custom/vless-proxy","custom/polycat","battery"],
	"reload_style_on_change": true,

"custom/polycat":{
    	"type": "custom/script",
        "exec": "polycat",
    },
"custom/clock":{
    	"type": "custom/script",
        "exec": "binclock-rs",
    },


"custom/vless-proxy": {
  "format": "{}",
  "tooltip": "Нажми для включения/выключения VLESS-прокси",
  "exec": "~/.config/waybar/scripts/proxy_status.sh",
  "on-click": "~/.config/waybar/scripts/proxy_toggle.sh",
  "interval": 3
},
"battery": {
    "interval": 60,
    "states": {
        "purple": 100,
        "green": 60,
        "yellow": 45,
        "orange": 30,
        "red": 15,


    	},
    "format": "{icon} {capacity}%",
    "format-icons": [".","⣀","⣄","⣤", "⣦", "⣶", "⣷", "⣿"],
    "max-length": 25
}
}
}
